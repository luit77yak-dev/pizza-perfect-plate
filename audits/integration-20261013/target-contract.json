        "address_street",
        "address_number",
        "address_neighborhood"
      ],
      "pricing": "SQL authoritative; caller subtotal is not trusted"
    },
    "append": {
      "route": "POST /api/order-amend",
      "private_rpc": "neroxa_append_order_items_with_capability",
      "credential": "256-bit base64url token; SHA256 stored on server, raw token only sessionStorage",
      "allowed_statuses": [
        "RECEIVED",
        "CONFIRMED"
      ],
      "financial_result": "NOT_SETTLED",
      "idempotency": "request key + payload digest"
    },
    "admin": {
      "transport": "authenticated primary Supabase client, no service role in browser",
      "read": "get_admin_orders(uuid,text)",
      "status": "update_admin_order_status(uuid,text,text)",
      "instance": "Explicit requested instance or verified current domain; grants/roles/MFA enforced by Master SQL"
    },
    "tracking": {
      "rpc": "get_public_order_status(uuid,text)",
      "limitation": "Phone-based authorization remains unresolved, not equivalent to buyer capability"
    }
  },
